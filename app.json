{
  "expo": {
    "name": "Vox Language",
    "slug": "vox-language-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "vox-language-app",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voxlanguage.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Vox needs microphone access for voice conversations with AI tutors.",
        "NSSpeechRecognitionUsageDescription": "Vox uses speech recognition for language practice.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.voxlanguage.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableCRSQLite": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a119f61-d22f-44fa-b9f7-eac4c3b8d773"
      }
    },
    "owner": "angel2255"
  }
}

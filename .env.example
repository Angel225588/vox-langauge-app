# Anthropic (Claude) API - For AI orchestration
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: Specify Claude model (defaults to claude-opus-4-5-20251101)
# CLAUDE_MODEL=claude-opus-4-5-20251101

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini AI Configuration (for future use)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration (for speech-to-text with Whisper API)
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs Configuration (for premium voice conversations)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
EXPO_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Get your Agent ID from: https://elevenlabs.io/app/conversational-ai
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Google Cloud TTS Configuration (for high-quality text-to-speech)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Cloud Text-to-Speech API at: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
EXPO_PUBLIC_GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
